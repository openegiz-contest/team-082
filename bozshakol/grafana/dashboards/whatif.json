  {
   "type": "table",
   "title": "Прогноз на 48 ч: все показатели",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "opentwins-influxdb"
     },
     "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r.thingId == \"kz.bozshakol:whatif\" and r._field =~ /^value_(base|scen|delta)_.*_properties_value$/)\n  |> last()\n  |> map(fn: (r) => ({kind: strings.split(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), t: \"_\")[0], kpi: strings.trimSuffix(v: strings.trimPrefix(v: strings.trimPrefix(v: strings.trimPrefix(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), prefix: \"base_\"), prefix: \"scen_\"), prefix: \"delta_\"), suffix: \"_properties_value\"), _value: r._value}))\n  |> group()\n  |> pivot(rowKey: [\"kpi\"], columnKey: [\"kind\"], valueColumn: \"_value\")"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "kpi": "показатель",
       "base": "база",
       "scen": "сценарий",
       "delta": "Δ, %"
      },
      "indexByName": {
       "kpi": 0,
       "base": 1,
       "scen": 2,
       "delta": 3
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Δ, %"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#e5534b",
           "value": null
          },
          {
           "color": "#8b96a2",
           "value": -0.5
          },
          {
           "color": "#4fbf7a",
           "value": 0.5
          }
         ]
        }
       }
      ]
     }
    ]
