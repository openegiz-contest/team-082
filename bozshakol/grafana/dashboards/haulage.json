      "uid": "opentwins-influxdb"
     },
     "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId =~ /^kz[.]bozshakol:ht-/ and r._field == \"value_state_properties_value\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, twin: strings.toUpper(v: strings.split(v: r.thingId, t: \":\")[1])}))\n  |> group(columns: [\"twin\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
